{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace Check report v1",
  "description": "Explicit export of a full redacted canonical run and structural observations. Exported flags are not trusted import inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "generated_at",
    "review_method",
    "limitations",
    "redaction_count",
    "run",
    "flags"
  ],
  "properties": {
    "report_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_method": {
      "type": "string"
    },
    "limitations": {
      "type": "string"
    },
    "redaction_count": {
      "type": "integer",
      "minimum": 0
    },
    "run": {
      "$ref": "#/$defs/redactedRun"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "step_id",
          "severity",
          "title",
          "evidence",
          "uncertainty"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "enum": [
              "repeated_call",
              "unmatched_result",
              "tool_error",
              "missing_result"
            ]
          },
          "step_id": {
            "type": "string"
          },
          "severity": {
            "const": "review"
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          }
        }
      }
    }
  },
  "$comment": "Each flag step_id must reference a step in run. Export always includes the full run regardless of UI filters. Reports are not canonical-run imports; extract run for reimport, which recomputes observations. Pattern redaction can expand strings, so a near-limit report run may exceed canonical import field/byte limits and require manual reduction.",
  "$defs": {
    "redactedRun": {
      "title": "Redacted canonical run shape",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "task",
        "status",
        "steps"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "const": "completed"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "task",
                  "assistant",
                  "tool_call",
                  "tool_result"
                ]
              },
              "content": {
                "type": "string"
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "call_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "ok",
                  "error"
                ]
              }
            }
          }
        }
      }
    }
  }
}
